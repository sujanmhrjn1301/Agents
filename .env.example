# ─── API Keys (required) ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# ─── Video Generation (Gradio Client / Hugging Face) ──────────────────────
# Default space: Lightricks/ltx-video-distilled (ultra-fast 15-20s video generation)
GRADIO_SPACE_ID=Lightricks/ltx-video-distilled
# Optional: Hugging Face User Access Token (recommended for higher priority/rate limits)
HF_TOKEN=

INSTAGRAM_ACCOUNT_ID=17841400000000000
INSTAGRAM_ACCESS_TOKEN=IGQVJxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase Storage (optional — for hosting the reel before IG publish) ─────
# Leave blank to use file.io as a free temporary host instead.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=reels

# ─── Visual Generation Engine ────────────────────────────────────────────────
# Default: motion_image (FLUX 9:16 high-res + Ken Burns camera motion — fast, free, no quota limits)
# Options: motion_image | siliconflow | gradio
VISUAL_ENGINE=motion_image

# ─── SiliconFlow API (optional fallback for FLUX image & video generation) ────
SILICONFLOW_API_KEY=

# ─── Bot Behaviour ──────────────────────────────────────────────────────────
# How many minutes to wait between reels in 24/7 mode (default: 60)
LOOP_INTERVAL_MINUTES=60

# ─── Auto-Inbox Agent (Meta Webhook for DMs) ───────────────────────────────────
WEBHOOK_VERIFY_TOKEN=autoreel_verify_2026
INBOX_PORT=8000
